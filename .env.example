ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_key_here
ALPACA_DATA_FEED=iex
FRED_API_KEY=your_fred_api_key_here
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
PAPER_BOT_AUTOSTART=active
# Optional selected bot mode when the server boots without autostart.
# PAPER_BOT_DEFAULT_MODE=safe
PAPER_BOT_KEEP_AWAKE=true
# Live trading is blocked unless ALLOW_LIVE_TRADING exactly matches the
# acknowledgment below. Even then, live autostart stays blocked unless
# ALLOW_LIVE_AUTOSTART is set too. Keep both unset for paper trading.
# ALLOW_LIVE_TRADING=I_UNDERSTAND_THIS_CAN_LOSE_REAL_MONEY
# ALLOW_LIVE_AUTOSTART=I_UNDERSTAND_THIS_CAN_LOSE_REAL_MONEY
# Live micro-probe defaults: one tiny position at a time after explicit unlock.
LIVE_BOT_MAX_POSITIONS=1
LIVE_BOT_MIN_NOTIONAL=5
LIVE_BOT_STOCK_MAX_NOTIONAL=25
LIVE_BOT_CRYPTO_MAX_NOTIONAL=15
# Analyzer sidecar: starts with npm run dev:forever/start-bot.bat and watches
# paper-bot-trades.csv. It waits quietly until the first closed trade exists.
PAPER_BOT_ANALYZER_AUTOSTART=true
PAPER_BOT_ANALYZER_INTERVAL_SECONDS=60
PAPER_BOT_ANALYZER_MIN_TRADES=100
# PAPER_BOT_ANALYZER_MODE=active
# PAPER_BOT_ANALYZER_EQUITY=10000
# PAPER_BOT_ANALYZER_TARGET_ANNUAL_RETURN=0.25
# PAPER_BOT_ANALYZER_MAX_DRAWDOWN_PCT=5
# Paper has no trade-count/streak stop, but this keeps the daily dollar-loss
# circuit breaker active. Set false only for an intentionally loss-unbounded lab.
PAPER_BOT_ENFORCE_DAILY_RISK_GUARD=true
# Live-realistic cost model (truth serum). Paper fills are idealized; this models
# the spread + slippage + fees a live fill would pay and shows a net-of-cost P&L
# next to the gross. Set PAPER_BOT_COST_MODEL=false to see raw paper numbers.
# Bps values are PER LEG (entry and exit each pay them). Defaults shown.
PAPER_BOT_COST_MODEL=true
PAPER_BOT_STOCK_SLIPPAGE_BPS=3
PAPER_BOT_CRYPTO_SLIPPAGE_BPS=5
PAPER_BOT_STOCK_FEE_BPS=0
# Alpaca crypto is routed as MARKET (taker) orders -> Tier-1 taker fee is 0.25%
# per leg. Use 25, not the 15 bps maker rate, or the cost model understates fees.
PAPER_BOT_CRYPTO_FEE_BPS=25
# Non-blocking telemetry only: for Alpaca crypto buys, log what a synthetic
# maker/post-only entry would have seen. Does not change routing or block trades.
PAPER_BOT_MAKER_SHADOW=true
# Discord radar/status webhook. WATCH/CHECK/status messages go here.
DISCORD_TRADING_WEBHOOK_URL=
# Optional separate Discord webhook for bot trade opens/closes only.
DISCORD_TRADE_WEBHOOK_URL=
# Optional separate Discord webhook for BOT WATCH status/vitals. If blank, bot
# status falls back to DISCORD_TRADE_WEBHOOK_URL, then DISCORD_TRADING_WEBHOOK_URL.
DISCORD_BOT_WEBHOOK_URL=
# Bot watch/status updates. One message is posted, then edited.
DISCORD_BOT_STATUS_INTERVAL_MINUTES=3
DISCORD_BOT_STATUS_EDIT_WINDOW_MINUTES=360
# Macro-event blackout: pause NEW entries around scheduled US data prints (FOMC,
# CPI, NFP) that blow out spreads and gap stops. Open positions keep their stops.
# On by default. NFP (first Friday 08:30 ET) and FOMC dates are built in; add CPI
# (or anything) as comma-separated LABEL@ISO-UTC.
PAPER_BOT_MACRO_BLACKOUT=true
PAPER_BOT_MACRO_BLACKOUT_PRE_MIN=2
PAPER_BOT_MACRO_BLACKOUT_POST_MIN=10
# PAPER_BOT_MACRO_EVENTS=CPI@2026-07-15T12:30:00Z,CPI@2026-08-12T12:30:00Z
# Default is stocks-only. Set true only when crypto keys/venue are configured.
BOT_ENABLE_CRYPTO=false
# Crypto venue: alpaca keeps the old Alpaca paper crypto path. binance routes
# crypto orders to Binance Spot Testnet while stocks stay on Alpaca paper.
BOT_CRYPTO_VENUE=alpaca
# Used when BOT_CRYPTO_VENUE=binance. Market orders are modeled as taker fills.
PAPER_BOT_BINANCE_TAKER_FEE_BPS=10
# Binance Spot Testnet.
# Generate an HMAC_SHA256 key at https://testnet.binance.vision (GitHub login),
# paste the key + secret here, restart, then open /api/binance/test to verify.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
